{
  "name": "create-kirigami",
  "version": "0.1.0",
  "description": "A CLI that scaffolds React/Next.js projects with correct Feature-Sliced Design (FSD) architecture.",
  "author": "Akram Almnajed (https://github.com/AkramAlmnajed)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkramAlmnajed/kirigami.git"
  },
  "bugs": {
    "url": "https://github.com/AkramAlmnajed/kirigami/issues"
  },
  "homepage": "https://github.com/AkramAlmnajed/kirigami#readme",
  "type": "module",
  "bin": {
    "kirigami": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "fsd",
    "feature-sliced-design",
    "cli",
    "scaffold",
    "react",
    "nextjs",
    "vite",
    "ink"
  ],
  "dependencies": {
    "@feature-sliced/steiger-plugin": "^0.6.0",
    "chalk": "^5.3.0",
    "execa": "^9.5.1",
    "figlet": "^1.8.0",
    "fs-extra": "^11.2.0",
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "meow": "^13.2.0",
    "react": "^18.3.1",
    "steiger": "^0.5.13",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "typescript": "^5.7.2"
  }
}
